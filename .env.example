# ──────────────────────────────────────────────────────────────
# .env.example — RP-AGB
#
# Copiá este archivo a ".env" y completá los valores reales.
# NUNCA commitees el archivo ".env" al repositorio.
#
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# Puerto donde corre el frontend en tu máquina local.
# Cambialo si el 3000 ya está ocupado (ej: 3001, 4000, etc.)
FRONTEND_PORT=3000

# Variables de entorno públicas de Next.js (visibles en el browser).
# Deben empezar con NEXT_PUBLIC_
# NEXT_PUBLIC_API_URL=http://localhost:5000
