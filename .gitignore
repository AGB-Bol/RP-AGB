# RP-AGB - Git Ignore

# Environment variables
.env
.env.local
.env.*.local

# Node.js dependencies
node_modules/
**/node_modules/

# pnpm cache
.pnpm-store/
**/.pnpm-store/
frontend/.pnpm-store/

# Next.js generated files
frontend/.next/
frontend/out/

# TypeScript generated files
*.tsbuildinfo

# .NET generated files
**/bin/
**/obj/

# Operating system files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
.vs/
**/.vs/
*.suo
*.user

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Docker local volumes
.docker-data/
